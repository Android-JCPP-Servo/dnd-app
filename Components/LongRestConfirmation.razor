<div class="dnd-confirm-backdrop">
    <div class="dnd-confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="dnd-longrest-title">
        <h2 id="dnd-longrest-title" class="dnd-confirm-title">Long Rest</h2>
        <p class="dnd-confirm-body">
            Take a Long Rest? This will set current HP to your Hit Point Maximum, clear temporary HP,
            restore hit dice remaining to your hit dice total, clear all expended spell slots, and
            clear death save successes and failures.
        </p>
        <div class="dnd-confirm-actions">
            <button type="button" class="dnd-confirm-cancel" @onclick="HandleCancelAsync">Cancel</button>
            <button type="button" class="dnd-confirm-delete" @onclick="HandleConfirmAsync">Long Rest</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnConfirmed { get; set; }

    [Parameter] public EventCallback OnCancelled { get; set; }

    /// <summary>
    /// Cancelling must leave the character untouched — this notifies the host and performs no
    /// store call whatsoever.
    /// </summary>
    private async Task HandleCancelAsync()
    {
        await OnCancelled.InvokeAsync();
    }

    private async Task HandleConfirmAsync()
    {
        await OnConfirmed.InvokeAsync();
    }
}
