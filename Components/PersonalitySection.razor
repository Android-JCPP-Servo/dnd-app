<div class="dnd-personality">
    <label class="dnd-personality-field">
        <span class="dnd-personality-label">Personality Traits</span>
        <textarea class="dnd-personality-input" rows="3" value="@Character.Personality.PersonalityTraits"
                  @oninput="HandlePersonalityTraitsInput"></textarea>
    </label>

    <label class="dnd-personality-field">
        <span class="dnd-personality-label">Ideals</span>
        <textarea class="dnd-personality-input" rows="3" value="@Character.Personality.Ideals"
                  @oninput="HandleIdealsInput"></textarea>
    </label>

    <label class="dnd-personality-field">
        <span class="dnd-personality-label">Bonds</span>
        <textarea class="dnd-personality-input" rows="3" value="@Character.Personality.Bonds"
                  @oninput="HandleBondsInput"></textarea>
    </label>

    <label class="dnd-personality-field">
        <span class="dnd-personality-label">Flaws</span>
        <textarea class="dnd-personality-input" rows="3" value="@Character.Personality.Flaws"
                  @oninput="HandleFlawsInput"></textarea>
    </label>
</div>

@code {
    [Parameter, EditorRequired] public CharacterSheet Character { get; set; } = default!;

    [Inject] private ICharacterAutosaveService Autosave { get; set; } = default!;

    private void HandlePersonalityTraitsInput(ChangeEventArgs e)
    {
        Character.Personality.PersonalityTraits = e.Value?.ToString() ?? string.Empty;
        Autosave.NotifyChanged(Character);
    }

    private void HandleIdealsInput(ChangeEventArgs e)
    {
        Character.Personality.Ideals = e.Value?.ToString() ?? string.Empty;
        Autosave.NotifyChanged(Character);
    }

    private void HandleBondsInput(ChangeEventArgs e)
    {
        Character.Personality.Bonds = e.Value?.ToString() ?? string.Empty;
        Autosave.NotifyChanged(Character);
    }

    private void HandleFlawsInput(ChangeEventArgs e)
    {
        Character.Personality.Flaws = e.Value?.ToString() ?? string.Empty;
        Autosave.NotifyChanged(Character);
    }
}
