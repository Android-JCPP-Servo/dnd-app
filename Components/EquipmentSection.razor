<div class="dnd-coin-purse">
    <label class="dnd-coin-field">
        <span class="dnd-coin-label">CP</span>
        <div class="dnd-coin-stepper">
            <button type="button" class="dnd-coin-btn" aria-label="Decrease copper by 1"
                    @onclick="() => AdjustCoin(() => Character.Coins.Copper, v => Character.Coins.Copper = v, -1)">&minus;</button>
            <input type="number" inputmode="numeric" class="dnd-coin-value" value="@Character.Coins.Copper"
                   @oninput="e => SetCoinValue(v => Character.Coins.Copper = v, e)" />
            <button type="button" class="dnd-coin-btn" aria-label="Increase copper by 1"
                    @onclick="() => AdjustCoin(() => Character.Coins.Copper, v => Character.Coins.Copper = v, 1)">+</button>
        </div>
    </label>

    <label class="dnd-coin-field">
