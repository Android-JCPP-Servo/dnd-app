            <button type="button" class="dnd-coin-btn" aria-label="Increase electrum by 1"
                    @onclick="() => AdjustCoin(() => Character.Coins.Electrum, v => Character.Coins.Electrum = v, 1)">+</button>
        </div>
    </label>

    <label class="dnd-coin-field">
        <span class="dnd-coin-label">GP</span>
