<RepeatingSection TRow="TextEntry"
                  Rows="Character.Equipment"
                  RowFactory="() => new TextEntry()"
                  AddLabel="Add Item"
                  EmptyText="No equipment yet."
                  OnChanged="HandleChanged">
    <RowTemplate Context="item">
        <input type="text" class="dnd-equipment-input" value="@item.Text"
               aria-label="Equipment item" @oninput="e => SetItemText(item, e)" />
    </RowTemplate>
</RepeatingSection>

@code {
    [Parameter, EditorRequired] public CharacterSheet Character { get; set; } = default!;

    [Inject] private ICharacterAutosaveService Autosave { get; set; } = default!;

    private void SetItemText(TextEntry item, ChangeEventArgs e)
    {
        item.Text = e.Value?.ToString() ?? string.Empty;
        Autosave.NotifyChanged(Character);
    }

    private void HandleChanged()
    {
        Autosave.NotifyChanged(Character);
    }

    private void AdjustCoin(Func<int> getValue, Action<int> setValue, int delta)
    {
        var next = Math.Max(0, getValue() + delta);
        setValue(next);
        Autosave.NotifyChanged(Character);
    }

    private void SetCoinValue(Action<int> setValue, ChangeEventArgs e)
    {
        var parsed = int.TryParse(e.Value?.ToString(), out var value) ? value : 0;
        setValue(Math.Max(0, parsed));
        Autosave.NotifyChanged(Character);
    }
}
